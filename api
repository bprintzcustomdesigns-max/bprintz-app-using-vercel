Step 4: Connect Your Frontend (index.html)

Add this checkout function to your index.html and link it to your checkout button. It also checks the URL when the user returns from Stripe so you can show a confirmation message and clear their cart:
html
<button id="stripe-checkout-btn" onclick="proceedToCheckout()">
  Proceed to Checkout
</button>

<script>
  async function proceedToCheckout() {
    const btn = document.getElementById('stripe-checkout-btn');
    btn.disabled = true;
    btn.innerText = 'Connecting to Checkout...';

    // Replace this sample array with your actual storefront cart variable
    const cartItems = [
      {
        name: 'Custom Printed Heavy Hoodie',
        size: 'L',
        printType: 'Front & Back DTF',
        price: 65.00,
        quantity: 1
      }
    ];

    try {
      const response = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cartItems,
          fulfillmentMethod: 'pickup' // or 'shipping'
        })
      });

      const data = await response.json();

      if (data.url) {
        // Redirects to Stripe Hosted Checkout (works in browser and Android APK)
        window.location.href = data.url;
      } else {
        alert('Checkout error: ' + (data.error || 'Unable to start session'));
        btn.disabled = false;
        btn.innerText = 'Proceed to Checkout';
      }
    } catch (error) {
      console.error(error);
      alert('Network error starting checkout.');
      btn.disabled = false;
      btn.innerText = 'Proceed to Checkout';
    }
  }

  // Handle return from Stripe inside your app
  window.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('payment') === 'success') {
      alert('Order confirmed! Thank you for shopping with Bprintz Custom Designs.');
      // Add your code here to clear the cart and clean the URL
      window.history.replaceState({}, document.title, window.location.pathname);
    } else if (params.get('payment') === 'cancelled') {
      alert('Checkout was cancelled. Your items are still in your cart.');
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  });
</script>
